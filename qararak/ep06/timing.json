{"lines": [{"id": "L0", "text": "أغلبكم قال: خلّه ياخذ جزاه… وأخذه!", "start": 0.1, "end": 3.54, "words": [{"w": "أغلبكم", "s": 0.1, "e": 0.66}, {"w": "قال:", "s": 0.86, "e": 1.14}, {"w": "خلّه", "s": 1.46, "e": 1.753}, {"w": "ياخذ", "s": 1.807, "e": 2.02}, {"w": "جزاه…", "s": 2.1, "e": 2.9}, {"w": "وأخذه!", "s": 2.94, "e": 3.54}]}, {"id": "L1", "text": "كمّلت القضية… والقاضي حكم على أبو فهد.", "start": 3.94, "end": 7.14, "words": [{"w": "كمّلت", "s": 3.94, "e": 4.26}, {"w": "القضية…", "s": 4.34, "e": 5.14}, {"w": "والقاضي", "s": 5.26, "e": 5.78}, {"w": "حكم", "s": 5.94, "e": 6.26}, {"w": "على", "s": 6.34, "e": 6.42}, {"w": "أبو", "s": 6.46, "e": 6.66}, {"w": "فهد.", "s": 6.74, "e": 7.14}]}, {"id": "L2", "text": "سنة سجن… ويرجّع كل ريال.", "start": 7.46, "end": 9.78, "words": [{"w": "سنة", "s": 7.46, "e": 7.78}, {"w": "سجن…", "s": 7.98, "e": 8.42}, {"w": "ويرجّع", "s": 8.58, "e": 8.98}, {"w": "كل", "s": 9.06, "e": 9.3}, {"w": "ريال.", "s": 9.38, "e": 9.78}]}, {"id": "L3", "text": "انقفلت القضية… وأخيراً ارتحت.", "start": 10.1, "end": 12.98, "words": [{"w": "انقفلت", "s": 10.1, "e": 10.58}, {"w": "القضية…", "s": 10.62, "e": 11.46}, {"w": "وأخيراً", "s": 11.54, "e": 12.3}, {"w": "ارتحت.", "s": 12.34, "e": 12.98}]}, {"id": "L4", "text": "بس وأنت طالع… شفت ولده.", "start": 13.38, "end": 15.38, "words": [{"w": "بس", "s": 13.38, "e": 13.54}, {"w": "وأنت", "s": 13.58, "e": 13.78}, {"w": "طالع…", "s": 13.94, "e": 14.58}, {"w": "شفت", "s": 14.7, "e": 14.9}, {"w": "ولده.", "s": 15.02, "e": 15.38}]}, {"id": "L5", "text": "واقف لحاله… تحت المطر.", "start": 15.7, "end": 17.54, "words": [{"w": "واقف", "s": 15.7, "e": 16.02}, {"w": "لحاله…", "s": 16.1, "e": 16.74}, {"w": "تحت", "s": 16.82, "e": 16.98}, {"w": "المطر.", "s": 17.1, "e": 17.54}]}, {"id": "L6", "text": "ماحد جا ياخذه.", "start": 17.86, "end": 19.06, "words": [{"w": "ماحد", "s": 17.86, "e": 18.1}, {"w": "جا", "s": 18.18, "e": 18.26}, {"w": "ياخذه.", "s": 18.34, "e": 19.06}]}, {"id": "L7", "text": "قرّب منك وقال: أبوي… متى يرجع؟", "start": 19.14, "end": 22.58, "words": [{"w": "قرّب", "s": 19.14, "e": 19.46}, {"w": "منك", "s": 19.58, "e": 19.86}, {"w": "وقال:", "s": 19.98, "e": 20.42}, {"w": "أبوي…", "s": 20.82, "e": 21.54}, {"w": "متى", "s": 21.66, "e": 21.82}, {"w": "يرجع؟", "s": 21.86, "e": 22.58}]}, {"id": "L8", "text": "وش بتسوي؟", "start": 22.66, "end": 23.78, "words": [{"w": "وش", "s": 22.66, "e": 22.74}, {"w": "بتسوي؟", "s": 22.82, "e": 23.78}]}, {"id": "L9", "text": "A: تتكفّل فيه… لين يطلع أبوه.", "start": 23.9, "end": 26.82, "words": [{"w": "A:", "s": 23.9, "e": 24.42}, {"w": "تتكفّل", "s": 24.5, "e": 25.06}, {"w": "فيه…", "s": 25.14, "e": 25.54}, {"w": "لين", "s": 25.66, "e": 25.78}, {"w": "يطلع", "s": 25.82, "e": 26.1}, {"w": "أبوه.", "s": 26.14, "e": 26.82}]}, {"id": "L10", "text": "B: تمشي… مو مسؤوليتك.", "start": 26.9, "end": 29.46, "words": [{"w": "B:", "s": 26.9, "e": 27.54}, {"w": "تمشي…", "s": 27.66, "e": 28.18}, {"w": "مو", "s": 28.26, "e": 28.34}, {"w": "مسؤوليتك.", "s": 28.5, "e": 29.46}]}, {"id": "L11", "text": "اكتب حرفك… هذا آخر قرار بالقصة.", "start": 29.5, "end": 32.74, "words": [{"w": "اكتب", "s": 29.5, "e": 29.78}, {"w": "حرفك…", "s": 29.86, "e": 30.66}, {"w": "هذا", "s": 30.74, "e": 31.06}, {"w": "آخر", "s": 31.14, "e": 31.54}, {"w": "قرار", "s": 31.7, "e": 31.86}, {"w": "بالقصة.", "s": 31.94, "e": 32.74}]}], "duration": 34.34, "vo_offset": 0.1, "speed": 1.0}