{"lines": [{"id": "L0", "text": "طلع صادق! البنك أكّد… الحوالة حقيقية.", "start": 0.157, "end": 3.414, "words": [{"w": "طلع", "s": 0.157, "e": 0.367}, {"w": "صادق!", "s": 0.443, "e": 0.881}, {"w": "البنك", "s": 1.205, "e": 1.567}, {"w": "أكّد…", "s": 1.605, "e": 2.043}, {"w": "الحوالة", "s": 2.271, "e": 2.767}, {"w": "حقيقية.", "s": 2.805, "e": 3.414}]}, {"id": "L1", "text": "ثمانين ألف وصلتني بالغلط… ورحت البنك مثل ما اخترتوا.", "start": 3.852, "end": 7.357, "words": [{"w": "ثمانين", "s": 3.852, "e": 4.271}, {"w": "ألف", "s": 4.31, "e": 4.576}, {"w": "وصلتني", "s": 4.671, "e": 5.052}, {"w": "بالغلط…", "s": 5.09, "e": 5.586}, {"w": "ورحت", "s": 5.871, "e": 6.176}, {"w": "البنك", "s": 6.195, "e": 6.538}, {"w": "مثل", "s": 6.595, "e": 6.805}, {"w": "ما", "s": 6.824, "e": 6.9}, {"w": "اخترتوا.", "s": 6.9, "e": 7.357}]}, {"id": "L2", "text": "بس الموظف قال: الإرجاع ياخذ عشرة أيام.", "start": 7.681, "end": 10.386, "words": [{"w": "بس", "s": 7.681, "e": 7.852}, {"w": "الموظف", "s": 7.871, "e": 8.31}, {"w": "قال:", "s": 8.367, "e": 8.786}, {"w": "الإرجاع", "s": 8.824, "e": 9.338}, {"w": "ياخذ", "s": 9.376, "e": 9.681}, {"w": "عشرة", "s": 9.719, "e": 10.024}, {"w": "أيام.", "s": 10.062, "e": 10.386}]}, {"id": "L3", "text": "والرجّال اتصل يبكي… عملية أمه بكرة الصبح.", "start": 10.729, "end": 13.948, "words": [{"w": "والرجّال", "s": 10.729, "e": 11.205}, {"w": "اتصل", "s": 11.224, "e": 11.662}, {"w": "يبكي…", "s": 11.719, "e": 12.119}, {"w": "عملية", "s": 12.5, "e": 12.957}, {"w": "أمه", "s": 12.976, "e": 13.224}, {"w": "بكرة", "s": 13.262, "e": 13.51}, {"w": "الصبح.", "s": 13.51, "e": 13.948}]}, {"id": "L4", "text": "والمستشفى ما يدخلها… إلا إذا دفع اليوم.", "start": 14.157, "end": 16.9, "words": [{"w": "والمستشفى", "s": 14.157, "e": 14.729}, {"w": "ما", "s": 14.767, "e": 14.862}, {"w": "يدخلها…", "s": 14.9, "e": 15.413}, {"w": "إلا", "s": 15.776, "e": 16.043}, {"w": "إذا", "s": 16.081, "e": 16.271}, {"w": "دفع", "s": 16.31, "e": 16.576}, {"w": "اليوم.", "s": 16.595, "e": 16.9}]}, {"id": "L5", "text": "وصديقي يقول: لا تتدخل… مو مسؤوليتك.", "start": 17.281, "end": 19.986, "words": [{"w": "وصديقي", "s": 17.281, "e": 17.814}, {"w": "يقول:", "s": 17.833, "e": 18.176}, {"w": "لا", "s": 18.405, "e": 18.5}, {"w": "تتدخل…", "s": 18.538, "e": 19.186}, {"w": "مو", "s": 19.243, "e": 19.338}, {"w": "مسؤوليتك.", "s": 19.376, "e": 19.986}]}, {"id": "L6", "text": "وش بتسوي؟", "start": 20.329, "end": 20.938, "words": [{"w": "وش", "s": 20.329, "e": 20.443}, {"w": "بتسوي؟", "s": 20.481, "e": 20.938}]}, {"id": "L7", "text": "A: تحوّل له من فلوسك الحين… وتنتظر البنك يرجّع لك.", "start": 21.452, "end": 25.148, "words": [{"w": "A:", "s": 21.452, "e": 21.681}, {"w": "تحوّل", "s": 22.062, "e": 22.405}, {"w": "له", "s": 22.424, "e": 22.519}, {"w": "من", "s": 22.557, "e": 22.671}, {"w": "فلوسك", "s": 22.71, "e": 23.052}, {"w": "الحين…", "s": 23.071, "e": 23.529}, {"w": "وتنتظر", "s": 23.662, "e": 24.157}, {"w": "البنك", "s": 24.214, "e": 24.5}, {"w": "يرجّع", "s": 24.538, "e": 24.9}, {"w": "لك.", "s": 24.938, "e": 25.148}]}, {"id": "L8", "text": "B: تلتزم بالبنك… عشرة أيام يعني عشرة أيام.", "start": 25.624, "end": 29.281, "words": [{"w": "B:", "s": 25.624, "e": 25.852}, {"w": "تلتزم", "s": 26.195, "e": 26.633}, {"w": "بالبنك…", "s": 26.671, "e": 27.129}, {"w": "عشرة", "s": 27.376, "e": 27.719}, {"w": "أيام", "s": 27.757, "e": 28.176}, {"w": "يعني", "s": 28.252, "e": 28.557}, {"w": "عشرة", "s": 28.595, "e": 28.919}, {"w": "أيام.", "s": 28.976, "e": 29.281}]}, {"id": "L9", "text": "اكتب حرفك… وأرسلها لأحد لازم يعرف.", "start": 29.605, "end": 32.157, "words": [{"w": "اكتب", "s": 29.605, "e": 29.871}, {"w": "حرفك…", "s": 29.929, "e": 30.348}, {"w": "وأرسلها", "s": 30.519, "e": 30.938}, {"w": "لأحد", "s": 30.976, "e": 31.357}, {"w": "لازم", "s": 31.414, "e": 31.738}, {"w": "يعرف.", "s": 31.776, "e": 32.157}]}], "duration": 33.76, "vo_offset": 0.1, "speed": 1.05}