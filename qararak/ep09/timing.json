{"lines": [{"id": "L0", "text": "أبوي قبل وفاته بشهر… أفرغ صك البيت باسمي. ثلاثة ملايين.", "start": 0.231, "end": 4.586, "words": [{"w": "أبوي", "s": 0.231, "e": 0.511}, {"w": "قبل", "s": 0.586, "e": 0.792}, {"w": "وفاته", "s": 0.829, "e": 1.184}, {"w": "بشهر…", "s": 1.221, "e": 1.633}, {"w": "أفرغ", "s": 2.1, "e": 2.38}, {"w": "صك", "s": 2.436, "e": 2.642}, {"w": "البيت", "s": 2.661, "e": 2.979}, {"w": "باسمي.", "s": 3.035, "e": 3.408}, {"w": "ثلاثة", "s": 3.764, "e": 4.137}, {"w": "ملايين.", "s": 4.175, "e": 4.586}]}, {"id": "L1", "text": "وإخواني الأربعة… ما يدرون.", "start": 5.147, "end": 6.848, "words": [{"w": "وإخواني", "s": 5.147, "e": 5.521}, {"w": "الأربعة…", "s": 5.539, "e": 5.95}, {"w": "ما", "s": 6.324, "e": 6.399}, {"w": "يدرون.", "s": 6.436, "e": 6.848}]}, {"id": "L2", "text": "المحامي قال: الصك باسمك… ومحد له حق فيه.", "start": 7.296, "end": 10.436, "words": [{"w": "المحامي", "s": 7.296, "e": 7.726}, {"w": "قال:", "s": 7.782, "e": 8.044}, {"w": "الصك", "s": 8.324, "e": 8.698}, {"w": "باسمك…", "s": 8.736, "e": 9.128}, {"w": "ومحد", "s": 9.352, "e": 9.539}, {"w": "له", "s": 9.857, "e": 9.95}, {"w": "حق", "s": 10.007, "e": 10.193}, {"w": "فيه.", "s": 10.25, "e": 10.436}]}, {"id": "L3", "text": "بس أخوي الكبير غرقان بالديون… وأختي ساكنة بالإيجار مع عيالها.", "start": 10.904, "end": 14.661, "words": [{"w": "بس", "s": 10.904, "e": 11.035}, {"w": "أخوي", "s": 11.091, "e": 11.315}, {"w": "الكبير", "s": 11.334, "e": 11.726}, {"w": "غرقان", "s": 11.764, "e": 12.081}, {"w": "بالديون…", "s": 12.137, "e": 12.605}, {"w": "وأختي", "s": 12.979, "e": 13.221}, {"w": "ساكنة", "s": 13.278, "e": 13.577}, {"w": "بالإيجار", "s": 13.595, "e": 14.025}, {"w": "مع", "s": 14.081, "e": 14.212}, {"w": "عيالها.", "s": 14.25, "e": 14.661}]}, {"id": "L4", "text": "ولقيت ورقة بخط أبوي… مكتوب فيها: لا تعلّم إخوانك.", "start": 15.165, "end": 19.147, "words": [{"w": "ولقيت", "s": 15.165, "e": 15.539}, {"w": "ورقة", "s": 15.595, "e": 15.876}, {"w": "بخط", "s": 15.913, "e": 16.175}, {"w": "أبوي…", "s": 16.231, "e": 16.511}, {"w": "مكتوب", "s": 16.922, "e": 17.221}, {"w": "فيها:", "s": 17.278, "e": 17.651}, {"w": "لا", "s": 18.1, "e": 18.212}, {"w": "تعلّم", "s": 18.268, "e": 18.605}, {"w": "إخوانك.", "s": 18.642, "e": 19.147}]}, {"id": "L5", "text": "والليلة أخوي اتصل… يقول: تعال نقسم الورث.", "start": 19.633, "end": 22.53, "words": [{"w": "والليلة", "s": 19.633, "e": 19.969}, {"w": "أخوي", "s": 19.988, "e": 20.231}, {"w": "اتصل…", "s": 20.268, "e": 20.717}, {"w": "يقول:", "s": 20.941, "e": 21.259}, {"w": "تعال", "s": 21.539, "e": 21.764}, {"w": "نقسم", "s": 21.782, "e": 22.137}, {"w": "الورث.", "s": 22.156, "e": 22.53}]}, {"id": "L6", "text": "وش بتسوي؟", "start": 22.997, "end": 23.651, "words": [{"w": "وش", "s": 22.997, "e": 23.147}, {"w": "بتسوي؟", "s": 23.184, "e": 23.651}]}, {"id": "L7", "text": "A: تعلّمهم وتقسم البيت بينكم… وتخالف كلام أبوك.", "start": 24.193, "end": 28.1, "words": [{"w": "A:", "s": 24.193, "e": 24.399}, {"w": "تعلّمهم", "s": 24.773, "e": 25.39}, {"w": "وتقسم", "s": 25.427, "e": 25.876}, {"w": "البيت", "s": 25.913, "e": 26.231}, {"w": "بينكم…", "s": 26.268, "e": 26.792}, {"w": "وتخالف", "s": 26.829, "e": 27.408}, {"w": "كلام", "s": 27.464, "e": 27.707}, {"w": "أبوك.", "s": 27.726, "e": 28.1}]}, {"id": "L8", "text": "B: تسكت وتاخذه… هذي رغبة أبوك.", "start": 28.586, "end": 31.595, "words": [{"w": "B:", "s": 28.586, "e": 28.792}, {"w": "تسكت", "s": 29.165, "e": 29.633}, {"w": "وتاخذه…", "s": 29.726, "e": 30.212}, {"w": "هذي", "s": 30.567, "e": 30.885}, {"w": "رغبة", "s": 30.941, "e": 31.221}, {"w": "أبوك.", "s": 31.24, "e": 31.595}]}, {"id": "L9", "text": "اكتب حرفك… وأرسلها لأحد عنده إخوان.", "start": 32.044, "end": 34.324, "words": [{"w": "اكتب", "s": 32.044, "e": 32.324}, {"w": "حرفك…", "s": 32.38, "e": 32.773}, {"w": "وأرسلها", "s": 33.016, "e": 33.39}, {"w": "لأحد", "s": 33.408, "e": 33.745}, {"w": "عنده", "s": 33.782, "e": 33.913}, {"w": "إخوان.", "s": 33.969, "e": 34.324}]}], "duration": 35.92, "vo_offset": 0.1, "speed": 