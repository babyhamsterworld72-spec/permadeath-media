{"lines": [{"id": "L1", "text": "أغلبكم اخترتوا A… ورجّعت المحفظة.", "start": 0.35, "end": 3.31, "words": [{"w": "أغلبكم", "s": 0.35, "e": 0.91}, {"w": "اخترتوا", "s": 0.99, "e": 1.39}, {"w": "A…", "s": 1.47, "e": 2.11}, {"w": "ورجّعت", "s": 2.23, "e": 2.67}, {"w": "المحفظة.", "s": 2.71, "e": 3.31}]}, {"id": "L2", "text": "واللي اختاروا B… الكاميرا كانت بتفضحكم.", "start": 3.63, "end": 6.91, "words": [{"w": "واللي", "s": 3.63, "e": 3.79}, {"w": "اختاروا", "s": 3.91, "e": 4.19}, {"w": "B…", "s": 4.27, "e": 4.91}, {"w": "الكاميرا", "s": 5.03, "e": 5.47}, {"w": "كانت", "s": 5.55, "e": 5.87}, {"w": "بتفضحكم.", "s": 5.95, "e": 6.91}]}, {"id": "L3", "text": "طقّيت باب أبو فهد…", "start": 7.03, "end": 8.51, "words": [{"w": "طقّيت", "s": 7.03, "e": 7.39}, {"w": "باب", "s": 7.51, "e": 7.63}, {"w": "أبو", "s": 7.683, "e": 7.79}, {"w": "فهد…", "s": 7.87, "e": 8.51}]}, {"id": "L4", "text": "وأول ما شاف المحفظة… ابتسم.", "start": 8.63, "end": 11.07, "words": [{"w": "وأول", "s": 8.63, "e": 9.07}, {"w": "ما", "s": 9.15, "e": 9.23}, {"w": "شاف", "s": 9.27, "e": 9.47}, {"w": "المحفظة…", "s": 9.55, "e": 10.43}, {"w": "ابتسم.", "s": 10.59, "e": 11.07}]}, {"id": "L5", "text": "قال: كنت عارف إنك بترجعها.", "start": 11.39, "end": 13.95, "words": [{"w": "قال:", "s": 11.39, "e": 11.87}, {"w": "كنت", "s": 12.11, "e": 12.35}, {"w": "عارف", "s": 12.47, "e": 12.67}, {"w": "إنك", "s": 12.75, "e": 12.91}, {"w": "بترجعها.", "s": 12.95, "e": 13.95}]}, {"id": "L6", "text": "المحفظة ما طاحت صدفة… أنا اللي رميتها.", "start": 14.03, "end": 16.99, "words": [{"w": "المحفظة", "s": 14.03, "e": 14.51}, {"w": "ما", "s": 14.59, "e": 14.67}, {"w": "طاحت", "s": 14.71, "e": 14.99}, {"w": "صدفة…", "s": 15.11, "e": 15.79}, {"w": "أنا", "s": 15.83, "e": 15.95}, {"w": "اللي", "s": 16.03, "e": 16.11}, {"w": "رميتها.", "s": 16.19, "e": 16.99}]}, {"id": "L7", "text": "والكاميرا؟ حطّيتها عشان أشوفك بعيني.", "start": 17.11, "end": 19.95, "words": [{"w": "والكاميرا؟", "s": 17.11, "e": 17.63}, {"w": "حطّيتها", "s": 17.95, "e": 18.43}, {"w": "عشان", "s": 18.51, "e": 18.75}, {"w": "أشوفك", "s": 18.83, "e": 19.15}, {"w": "بعيني.", "s": 19.23, "e": 19.95}]}, {"id": "L8", "text": "اكتشفت إني ظلمتك… في أحد كذب عليّ عنك.", "start": 20.11, "end": 23.55, "words": [{"w": "اكتشفت", "s": 20.11, "e": 20.51}, {"w": "إني", "s": 20.55, "e": 20.67}, {"w": "ظلمتك…", "s": 20.83, "e": 21.71}, {"w": "في", "s": 21.79, "e": 21.87}, {"w": "أحد", "s": 21.91, "e": 22.19}, {"w": "كذب", "s": 22.27, "e": 22.51}, {"w": "عليّ", "s": 22.63, "e": 22.83}, {"w": "عنك.", "s": 22.99, "e": 23.55}]}, {"id": "L9", "text": "واللي وشى فيك… سعد.", "start": 23.63, "end": 25.63, "words": [{"w": "واللي", "s": 23.63, "e": 23.79}, {"w": "وشى", "s": 23.87, "e": 24.11}, {"w": "فيك…", "s": 24.19, "e": 24.91}, {"w": "سعد.", "s": 25.11, "e": 25.63}]}, {"id": "L10", "text": "صاحبك… اللي تدين له بستة آلاف.", "start": 25.79, "end": 28.11, "words": [{"w": "صاحبك…", "s": 25.79, "e": 26.35}, {"w": "اللي", "s": 26.39, "e": 26.51}, {"w": "تدين", "s": 26.59, "e": 26.91}, {"w": "له", "s": 26.99, "e": 27.07}, {"w": "بستة", "s": 27.11, "e": 27.47}, {"w": "آلاف.", "s": 27.51, "e": 28.11}]}, {"id": "L11", "text": "قال لي: ارجع لشغلك بكرة… والقرار في سعد بيدك.", "start": 28.23, "end": 32.19, "words": [{"w": "قال", "s": 28.23, "e": 28.35}, {"w": "لي:", "s": 28.47, "e": 28.83}, {"w": "ارجع", "s": 28.91, "e": 29.15}, {"w": "لشغلك", "s": 29.23, "e": 29.63}, {"w": "بكرة…", "s": 29.71, "e": 30.27}, {"w": "والقرار", "s": 30.35, "e": 30.75}, {"w": "في", "s": 30.83, "e": 30.91}, {"w": "سعد", "s": 30.99, "e": 31.23}, {"w": "بيدك.", "s": 31.31, "e": 32.19}]}, {"id": "L12", "text": "وش بتسوي؟ A: تفضحه قدام الكل… مثل ما انفضحت. B: تسامحه وتسكت. اكتب حرفك… والجزء الثالث بكرة.", "start": 32.27, "end": 41.47, "words": [{"w": "وش", "s": 32.27, "e": 32.35}, {"w": "بتسوي؟", "s": 32.43, "e": 33.31}, {"w": "A:", "s": 33.43, "e": 33.79}, {"w": "تفضحه", "s": 33.87, "e": 34.35}, {"w": "قدام", "s": 34.47, "e": 34.75}, {"w": "الكل…", "s": 34.83, "e": 35.39}, {"w": "مثل", "s": 35.51, "e": 35.63}, {"w": "ما", "s": 35.67, "e": 35.71}, {"w": "انفضحت.", "s": 35.75, "e": 36.67}, {"w": "B:", "s": 36.83, "e": 37.23}, {"w": "تسامحه", "s": 37.35, "e": 37.87}, {"w": "وتسكت.", "s": 38.03, "e": 38.91}, {"w": "اكتب", "s": 38.95, "e": 39.23}, {"w": "حرفك…", "s": 39.31, "e": 39.95}, {"w": "والجزء", "s": 40.03, "e": 40.43}, {"w": "الثالث", "s": 40.47, "e": 40.91}, {"w": "بكرة.", "s": 40.99, "e": 41.47}]}], "duration": 43.07, "vo_offset": 0.35}