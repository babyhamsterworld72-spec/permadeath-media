{"lines": [{"id": "L0", "text": "تم إيداع ثمانين ألف ريال!", "start": 0.1, "end": 2.157, "words": [{"w": "تم", "s": 0.1, "e": 0.252}, {"w": "إيداع", "s": 0.29, "e": 0.633}, {"w": "ثمانين", "s": 0.71, "e": 1.167}, {"w": "ألف", "s": 1.319, "e": 1.624}, {"w": "ريال!", "s": 1.7, "e": 2.157}]}, {"id": "L1", "text": "ما أعرف المرسل… ولا أنتظر أي فلوس.", "start": 2.538, "end": 4.976, "words": [{"w": "ما", "s": 2.538, "e": 2.614}, {"w": "أعرف", "s": 2.652, "e": 2.919}, {"w": "المرسل…", "s": 2.995, "e": 3.681}, {"w": "ولا", "s": 3.795, "e": 3.91}, {"w": "أنتظر", "s": 3.948, "e": 4.29}, {"w": "أي", "s": 4.329, "e": 4.443}, {"w": "فلوس.", "s": 4.519, "e": 4.976}]}, {"id": "L2", "text": "بعد ساعة… اتصل رقم غريب.", "start": 5.433, "end": 7.643, "words": [{"w": "بعد", "s": 5.433, "e": 5.662}, {"w": "ساعة…", "s": 5.738, "e": 6.424}, {"w": "اتصل", "s": 6.538, "e": 6.805}, {"w": "رقم", "s": 6.881, "e": 7.11}, {"w": "غريب.", "s": 7.186, "e": 7.643}]}, {"id": "L3", "text": "كان يبكي: حوّلتها لك بالغلط…", "start": 7.871, "end": 10.462, "words": [{"w": "كان", "s": 7.871, "e": 8.024}, {"w": "يبكي:", "s": 8.138, "e": 8.862}, {"w": "حوّلتها", "s": 8.938, "e": 9.395}, {"w": "لك", "s": 9.471, "e": 9.548}, {"w": "بالغلط…", "s": 9.624, "e": 10.462}]}, {"id": "L4", "text": "هذي فلوس عملية أمي… الله يخليك رجّعها.", "start": 10.538, "end": 13.433, "words": [{"w": "هذي", "s": 10.538, "e": 10.69}, {"w": "فلوس", "s": 10.767, "e": 10.995}, {"w": "عملية", "s": 11.071, "e": 11.529}, {"w": "أمي…", "s": 11.605, "e": 12.138}, {"w": "الله", "s": 12.214, "e": 12.367}, {"w": "يخليك", "s": 12.443, "e": 12.748}, {"w": "رجّعها.", "s": 12.824, "e": 13.433}]}, {"id": "L5", "text": "وقبل أحوّل… صديقي قال: لا تسويها!", "start": 13.814, "end": 16.786, "words": [{"w": "وقبل", "s": 13.814, "e": 14.119}, {"w": "أحوّل…", "s": 14.195, "e": 14.881}, {"w": "صديقي", "s": 15.033, "e": 15.338}, {"w": "قال:", "s": 15.49, "e": 15.795}, {"w": "لا", "s": 15.871, "e": 15.948}, {"w": "تسويها!", "s": 16.176, "e": 16.786}]}, {"id": "L6", "text": "هذي حيلة نصّابين… يحوّلون لك، ويطلبون ترجعها لحساب ثاني.", "start": 16.862, "end": 21.205, "words": [{"w": "هذي", "s": 16.862, "e": 17.09}, {"w": "حيلة", "s": 17.167, "e": 17.395}, {"w": "نصّابين…", "s": 17.471, "e": 18.386}, {"w": "يحوّلون", "s": 18.462, "e": 18.995}, {"w": "لك،", "s": 19.11, "e": 19.3}, {"w": "ويطلبون", "s": 19.376, "e": 19.757}, {"w": "ترجعها", "s": 19.871, "e": 20.29}, {"w": "لحساب", "s": 20.329, "e": 20.671}, {"w": "ثاني.", "s": 20.748, "e": 21.205}]}, {"id": "L7", "text": "وبعدها البنك يسحبها منك… مرتين.", "start": 21.433, "end": 24.1, "words": [{"w": "وبعدها", "s": 21.433, "e": 22.043}, {"w": "البنك", "s": 22.119, "e": 22.5}, {"w": "يسحبها", "s": 22.576, "e": 22.957}, {"w": "منك…", "s": 23.11, "e": 23.49}, {"w": "مرتين.", "s": 23.605, "e": 24.1}]}, {"id": "L8", "text": "وش بتسوي؟", "start": 24.405, "end": 25.471, "words": [{"w": "وش", "s": 24.405, "e": 24.481}, {"w": "بتسوي؟", "s": 24.557, "e": 25.471}]}, {"id": "L9", "text": "A: ترجّعها له فوراً.", "start": 25.586, "end": 27.681, "words": [{"w": "A:", "s": 25.586, "e": 25.852}, {"w": "ترجّعها", "s": 26.081, "e": 26.614}, {"w": "له", "s": 26.729, "e": 26.843}, {"w": "فوراً.", "s": 26.995, "e": 27.681}]}, {"id": "L10", "text": "B: ما ترجّع شي… إلا عن طريق البنك.", "start": 27.833, "end": 30.881, "words": [{"w": "B:", "s": 27.833, "e": 28.29}, {"w": "ما", "s": 28.367, "e": 28.443}, {"w": "ترجّع", "s": 28.519, "e": 28.9}, {"w": "شي…", "s": 28.976, "e": 29.357}, {"w": "إلا", "s": 29.395, "e": 29.586}, {"w": "عن", "s": 29.662, "e": 29.738}, {"w": "طريق", "s": 29.776, "e": 29.967}, {"w": "البنك.", "s": 30.043, "e": 30.881}]}, {"id": "L11", "text": "اكتب حرفك… وشوف وش صار بالجزء الثاني.", "start": 30.919, "end": 33.624, "words": [{"w": "اكتب", "s": 30.919, "e": 31.186}, {"w": "حرفك…", "s": 31.262, "e": 31.795}, {"w": "وشوف", "s": 31.91, "e": 32.176}, {"w": "وش", "s": 32.252, "e": 32.329}, {"w": "صار", "s": 32.443, "e": 32.557}, {"w": "بالجزء", "s": 32.633, "e": 32.938}, {"w": "الثاني.", "s": 32.976, "e": 33.624}]}], "duration": 35.22, "vo_offset": 0.1, "speed": 1.05, "trim": 1.6}